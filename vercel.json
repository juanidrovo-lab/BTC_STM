{
  "version": 2,
  "builds": [
    {"src": "api/*.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/api/health", "dest": "api/health.py"},
    {"src": "/api/paper-trade", "dest": "api/paper_trade.py"},
    {"src": "/api/backtest", "dest": "api/backtest.py"}
  ],
  "env": {
    "TRADING_MODE": "paper",
    "ENABLE_LIVE_TRADING": "false",
    "PERSISTENCE_BACKEND": "neon"
  }
}
