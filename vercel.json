{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "TRADING_MODE": "paper",
    "ENABLE_LIVE_TRADING": "false",
    "PERSISTENCE_BACKEND": "neon"
  },
  "crons": [
    {
      "path": "/api/paper-trade",
      "schedule": "* * * * *"
    }
  ]
}
