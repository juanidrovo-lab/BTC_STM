# Safe defaults: paper mode only.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# Risk controls
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_RISK_PER_TRADE_PCT=1.0
RISK_MAX_POSITION_NOTIONAL=10000
RISK_KILL_SWITCH=false

# ── Phase 2: Neon DB + Vercel ──────────────────────────────────────────────
# Get your DATABASE_URL from: https://console.neon.tech → Project → Connection string
# Format: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# "local"  → write session artifacts to the filesystem (default, no DB needed)
# "neon"   → write session data to Neon DB (requires DATABASE_URL above)
PERSISTENCE_BACKEND=local
