# ── Modo de trading ────────────────────────────────────────────────────────────
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# ── Binance ────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true  → usa testnet.binance.vision  (sin fondos reales)
# false → usa api.binance.com         (mainnet)
BINANCE_TESTNET=true

# ── Base de datos Neon DB ──────────────────────────────────────────────────────
# Obtén la connection string en: https://console.neon.tech → Connection string
# Formato: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PERSISTENCE_BACKEND=neon

# ── Activos a monitorizar ─────────────────────────────────────────────────────
ASSETS_TO_TRADE=BTCUSDT,ETHUSDT,SOLUSDT

# ── Frecuencia del loop ────────────────────────────────────────────────────────
# Minutos entre cada evaluación de estrategia.
# 5  → chequea cada 5 min (bueno para pruebas locales)
# 60 → alineado con cierre de vela 1h (producción)
LOOP_INTERVAL_MINUTES=5

# ── Control de riesgo ─────────────────────────────────────────────────────────
RISK_MAX_DAILY_LOSS_PCT=5.0
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_RISK_PER_TRADE_PCT=1.0
RISK_MAX_POSITION_NOTIONAL=10000
RISK_KILL_SWITCH=false
